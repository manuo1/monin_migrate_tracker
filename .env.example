# Copy to `.env` and fill in. NEVER commit `.env`. All values below are fake examples.

# --- Django ---
# (the settings module is chosen by manage.py (dev), pytest (test) and wsgi/asgi (prod), not by this file)
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Login throttling (django-axes): account locked after N failed attempts, for M minutes ---
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Logging (stdout) ---
# LOG_FORMAT: plain (default) or json (default in production). LOG_LEVEL: DEBUG, INFO, WARNING...
LOG_FORMAT=plain
LOG_LEVEL=INFO

# --- Database (SQLite in dev, PostgreSQL in prod) ---
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/mmt

# --- Attachments (keep outside the repository and outside any public web root) ---
MEDIA_ROOT=./media

# --- Vendor Jira (private: must not appear in the public repository) ---
JIRA_BASE_URL=https://your-company.atlassian.net/browse/
JIRA_CREATE_FORM_URL=https://your-company.atlassian.net/jira/software/form/00000000-0000-0000-0000-000000000000
JIRA_REF_PREFIX=PROJECT-
